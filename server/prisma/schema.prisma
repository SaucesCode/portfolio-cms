generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

model Hero {
  id               Int      @id @default(autoincrement())
  name             String
  tagline          String[] // array of strings for typewriter rotation
  bio              String
  profileImageUrl  String?
  resumeUrl        String?
  availableForWork Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("hero")
}

model Project {
  id             Int       @id @default(autoincrement())
  title          String
  description    String
  techStack      String[]
  imageUrl       String?
  liveUrl        String?
  githubUrl      String?
  githubRepoName String?
  stars          Int?
  forks          Int?
  language       String?
  githubSyncedAt DateTime?
  featured       Boolean   @default(false)
  orderIndex     Int       @default(0)
  createdAt      DateTime  @default(now())

  @@map("projects")
}

model Skill {
  id               Int    @id @default(autoincrement())
  name             String
  category         String // "Frontend" | "Backend" | "Tools" | "Other"
  proficiencyLevel Int    @default(3) // 1–5
  iconName         String?
  orderIndex       Int    @default(0)

  @@map("skills")
}

model Experience {
  id          Int       @id @default(autoincrement())
  company     String
  role        String
  description String
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  orderIndex  Int       @default(0)

  @@map("experiences")
}

model Certification {
  id            Int      @id @default(autoincrement())
  name          String
  issuer        String
  issueDate     DateTime
  credentialUrl String?
  badgeImageUrl String?
  orderIndex    Int      @default(0)

  @@map("certifications")
}

model Testimonial {
  id         Int     @id @default(autoincrement())
  name       String
  role       String
  company    String
  avatarUrl  String?
  quote      String
  orderIndex Int     @default(0)
  visible    Boolean @default(true)

  @@map("testimonials")
}

model BlogPost {
  id            Int       @id @default(autoincrement())
  title         String
  slug          String    @unique
  content       String    // markdown
  excerpt       String?
  coverImageUrl String?
  tags          String[]
  published     Boolean   @default(false)
  publishedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  @@map("blog_posts")
}

model Stat {
  id       Int    @id @default(autoincrement())
  label    String // e.g. "Projects Built"
  value    Int
  iconName String?

  @@map("stats")
}

model Message {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  subject    String?
  body       String
  isRead     Boolean  @default(false)
  receivedAt DateTime @default(now())

  @@map("messages")
}
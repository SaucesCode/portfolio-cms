generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  createdProjects Project[] @relation("ProjectCreatedBy")
  updatedProjects Project[] @relation("ProjectUpdatedBy")
  createdSkills   Skill[]   @relation("SkillCreatedBy")
  updatedSkills   Skill[]   @relation("SkillUpdatedBy")

  @@map("admin_users")
}

model Hero {
  id               Int      @id @default(autoincrement())
  name             String
  tagline          String[]
  bio              String
  profileImageUrl  String?
  resumeUrl        String?
  availableForWork Boolean  @default(true)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@map("hero")
}

model Project {
  id             Int           @id @default(autoincrement())
  title          String
  description    String
  techStack      String[]
  imageUrl       String?
  liveUrl        String?
  githubUrl      String?
  githubRepoName String?
  stars          Int?
  forks          Int?
  language       String?
  githubSyncedAt DateTime?
  featured       Boolean       @default(false)
  orderIndex     Int           @default(0)
  createdAt      DateTime      @default(now())

  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  scheduledAt    DateTime?
  archivedAt     DateTime?
  updatedAt      DateTime @default(now()) @updatedAt

  createdById    Int?
  updatedById    Int?
  createdBy      AdminUser?    @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      AdminUser?    @relation("ProjectUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("projects")
}

model Skill {
  id               Int     @id @default(autoincrement())
  name             String
  category         String
  proficiencyLevel Int     @default(3)
  iconName         String?
  orderIndex       Int     @default(0)

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  scheduledAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  createdById Int?
  updatedById Int?
  createdBy   AdminUser? @relation("SkillCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   AdminUser? @relation("SkillUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("skills")
}

model Experience {
  id          Int       @id @default(autoincrement())
  company     String
  role        String
  description String
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  orderIndex  Int       @default(0)

  @@map("experiences")
}

model Certification {
  id            Int      @id @default(autoincrement())
  name          String
  issuer        String
  issueDate     DateTime
  credentialUrl String?
  badgeImageUrl String?
  orderIndex    Int      @default(0)

  @@map("certifications")
}

model Testimonial {
  id         Int     @id @default(autoincrement())
  name       String
  role       String
  company    String
  avatarUrl  String?
  quote      String
  orderIndex Int     @default(0)
  visible    Boolean @default(true)

  @@map("testimonials")
}

model BlogPost {
  id            Int       @id @default(autoincrement())
  title         String
  slug          String    @unique
  content       String
  excerpt       String?
  coverImageUrl String?
  tags          String[]
  published     Boolean   @default(false)
  publishedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  @@map("blog_posts")
}

model Stat {
  id       Int     @id @default(autoincrement())
  label    String
  value    Int
  iconName String?

  @@map("stats")
}

model Message {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  subject    String?
  body       String
  isRead     Boolean  @default(false)
  receivedAt DateTime @default(now())

  @@map("messages")
}
